# Copy this file to .env and fill in your real key.
# NEVER commit the real .env file to git.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Ephemeral Session & Media Retention (in hours, default 12)
MEDIA_RETENTION_HOURS=12
# Background cleanup scan frequency (in minutes, default 30)
MEDIA_CLEANUP_INTERVAL_MINUTES=30
ENABLE_BACKGROUND_CLEANUP=true
